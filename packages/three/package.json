{
  "name": "@prismdeck/three",
  "version": "0.1.0",
  "description": "Optional Three.js and WebXR renderer for PrismDeck",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yosun/PrismDeck.git",
    "directory": "packages/three"
  },
  "homepage": "https://github.com/yosun/PrismDeck",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./xr": {
      "types": "./dist/xr.d.ts",
      "import": "./dist/xr.js"
    }
  },
  "files": [
    "dist",
    "src/style.css",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@prismdeck/core": "0.1.0"
  },
  "peerDependencies": {
    "three": ">=0.170.0 <1"
  }
}
